{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Created links",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "url_shortener_links_created_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Redirects",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "url_shortener_redirects_total", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum by (route, status) (rate(url_shortener_http_requests_total[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(url_shortener_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Cache results",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum by (result) (rate(url_shortener_cache_requests_total[5m]))", "legendFormat": "{{result}}", "refId": "A"}]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["go", "url-shortener"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "URL Shortener",
  "uid": "url-shortener"
}
